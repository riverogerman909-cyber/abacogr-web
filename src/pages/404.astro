---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base noindex={true} title="Página no encontrada · Ábaco" description="La página que buscás no existe o cambió de lugar. Volvé al inicio o pasá por las guías del blog de Ábaco.">
  <Header />
  <main id="main">
    <section class="nf">
      <div class="wrap">
        <p class="eyebrow">Error 404</p>
        <h1>Esa página no está<span class="dot">.</span></h1>
        <p class="nf-p">El enlace no existe o cambió de lugar. Nada grave: todo lo importante sigue acá.</p>
        <div class="nf-acciones">
          <a class="btn btn-primary" href="/">Ir al inicio</a>
          <a class="btn btn-ghost" href="/blog/">Ver las guías del blog</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .nf { padding: 170px 0 120px; }
  .nf h1 { margin-top: 14px; font-family: var(--font-title); font-weight: 600; font-size: clamp(34px, 5vw, 52px); letter-spacing: -0.03em; color: var(--ink); }
  .dot { color: var(--esmeralda); }
  .nf-p { margin-top: 14px; max-width: 50ch; font-size: 17px; line-height: 1.6; color: var(--grafito); }
  .nf-acciones { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; }
</style>
