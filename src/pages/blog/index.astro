---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const destacados = ['cuanto-cuesta-una-pagina-web-en-uruguay', 'instagram-o-pagina-web', 'dominio-uy-como-registrarlo', 'whatsapp-business-para-pymes', 'como-aparecer-en-google'];
const peso = (id: string) => { const i = destacados.indexOf(id); return i === -1 ? destacados.length : i; };
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || peso(a.id) - peso(b.id)
);
const fecha = new Intl.DateTimeFormat('es-UY', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://abacogr.com/blog/',
      name: 'Guías de presencia digital para pymes de Uruguay',
      inLanguage: 'es-UY',
      publisher: { '@id': 'https://abacogr.com/#org' },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://abacogr.com/blog/${p.id}/`, name: p.data.title })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://abacogr.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://abacogr.com/blog/' },
      ],
    },
  ],
});
---
<Base
  title="Guías de presencia digital para pymes · Ábaco"
  description="Guías claras y sin humo sobre webs, dominios, WhatsApp Business y Google para profesionales y pymes de Uruguay. Con precios reales y pasos concretos."
>
  <script type="application/ld+json" set:html={jsonLd} />
  <Header />
  <main id="main">
    <section class="blog-hero">
      <div class="wrap folio">
        <p class="eyebrow folio-label">Blog</p>
        <div class="folio-body">
          <h1>Guías de presencia digital,<br />explicadas en criollo<span class="dot">.</span></h1>
          <p class="lede">
            Guías claras para profesionales y pymes de Uruguay: qué cuesta una web, cómo funciona
            un dominio, qué configurar en WhatsApp. Sin humo y con pasos concretos.
          </p>
        </div>
      </div>
    </section>
    <section class="blog-lista">
      <div class="wrap folio">
        <p class="eyebrow folio-label" aria-hidden="true"></p>
        <div class="folio-body">
          {posts.map((post) => (
            <article class="entrada">
              <a href={`/blog/${post.id}/`} class="entrada-link">
                <time datetime={post.data.date.toISOString().slice(0, 10)}>{fecha.format(post.data.date)}</time>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <span class="leer">Leer la guía →</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .blog-hero { padding: 140px 0 24px; }
  h1 { font-family: var(--font-title); font-weight: 600; font-size: clamp(34px, 5.2vw, 54px); letter-spacing: -0.03em; line-height: 1.08; color: var(--ink); }
  .dot { color: var(--esmeralda); }
  .lede { margin-top: 18px; max-width: 58ch; font-size: 18px; line-height: 1.6; color: var(--grafito); }
  .blog-lista { padding: 24px 0 96px; }
  .entrada { border-top: 1px solid var(--line); }
  .entrada:last-child { border-bottom: 1px solid var(--line); }
  .entrada-link { display: block; padding: 30px 0 34px; }
  .entrada time { font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--esmeralda-text); }
  .entrada h2 { margin-top: 10px; font-family: var(--font-title); font-weight: 600; font-size: clamp(22px, 3vw, 28px); letter-spacing: -0.02em; line-height: 1.2; color: var(--ink); transition: color var(--t-fast) var(--ease-out); }
  .entrada-link:hover h2 { color: var(--esmeralda-text); }
  .entrada p { margin-top: 10px; max-width: 66ch; font-size: 16px; line-height: 1.6; color: var(--grafito); }
  .leer { display: inline-block; margin-top: 14px; font-size: 15px; font-weight: 600; color: var(--esmeralda-text); }
</style>
