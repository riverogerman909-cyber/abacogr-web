---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fecha = new Intl.DateTimeFormat('es-UY', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const iso = post.data.date.toISOString().slice(0, 10);
const url = `https://abacogr.com/blog/${post.id}/`;

const otros = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: iso,
      dateModified: iso,
      inLanguage: 'es-UY',
      mainEntityOfPage: { '@type': 'WebPage', '@id': url },
      keywords: post.data.keywords.join(', '),
      image: [`https://abacogr.com/og-blog-${post.id}.png`],
      author: { '@type': 'Organization', name: 'Ábaco', url: 'https://abacogr.com/' },
      publisher: { '@type': 'Organization', name: 'Ábaco', url: 'https://abacogr.com/', logo: { '@type': 'ImageObject', url: 'https://abacogr.com/favicon-192.png' } },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://abacogr.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://abacogr.com/blog/' },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
      ],
    },
  ],
});
---
<Base title={`${post.data.title} · Ábaco`} description={post.data.description} ogType="article" ogImage={`/og-blog-${post.id}.png`}>
  <script type="application/ld+json" set:html={jsonLd} />
  <Header />
  <main id="main">
    <article class="post">
      <div class="wrap">
        <header class="post-head">
          <nav class="migas" aria-label="Ruta">
            <a href="/">Inicio</a><span aria-hidden="true"> / </span><a href="/blog/">Blog</a>
          </nav>
          <time datetime={iso}>{fecha.format(post.data.date)}</time>
          <h1>{post.data.title}</h1>
        </header>
        <div class="prose">
          <Content />
        </div>
        <aside class="post-cta">
          <p class="post-cta-t">¿Preferís que lo resolvamos por vos?</p>
          <p>Armamos tu presencia digital completa, con precio publicado, entrega en días y todo a tu nombre.</p>
          <div class="post-cta-acciones">
            <a class="btn btn-primary" href="/#paquetes">Ver planes y precios</a>
            <a class="btn btn-ghost" href="/#contacto">Escribinos</a>
          </div>
        </aside>
        {otros.length > 0 && (
          <nav class="seguir" aria-label="Más artículos">
            <p class="eyebrow">Seguí leyendo</p>
            <ul>
              {otros.map((p) => (
                <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .post { padding: 130px 0 96px; }
  .post .wrap { max-width: 780px; }
  .migas { font-size: 14px; color: var(--grafito); }
  .migas a { color: var(--esmeralda-text); font-weight: 500; }
  .post-head time { display: block; margin-top: 26px; font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--esmeralda-text); }
  .post-head h1 { margin-top: 12px; font-family: var(--font-title); font-weight: 600; font-size: clamp(30px, 4.6vw, 44px); letter-spacing: -0.03em; line-height: 1.12; color: var(--ink); }
  .lede { margin-top: 16px; font-size: 19px; line-height: 1.6; color: var(--grafito); }
  .prose { margin-top: 44px; }
  .prose :global(h2) { margin: 44px 0 14px; font-family: var(--font-title); font-weight: 600; font-size: 26px; letter-spacing: -0.02em; line-height: 1.25; color: var(--ink); }
  .prose :global(h3) { margin: 30px 0 10px; font-family: var(--font-title); font-weight: 600; font-size: 19px; letter-spacing: -0.01em; color: var(--ink); }
  .prose :global(p) { margin: 14px 0; font-size: 17px; line-height: 1.75; color: var(--grafito); }
  .prose :global(ul), .prose :global(ol) { margin: 14px 0; padding-left: 24px; }
  .prose :global(li) { margin: 8px 0; font-size: 17px; line-height: 1.7; color: var(--grafito); }
  .prose :global(li::marker) { color: var(--esmeralda); }
  .prose :global(a) { color: var(--esmeralda-text); font-weight: 500; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--esmeralda) 40%, transparent); text-underline-offset: 3px; }
  .prose :global(a:hover) { text-decoration-color: var(--esmeralda); }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(blockquote) { margin: 22px 0; padding: 4px 0 4px 20px; border-left: 3px solid var(--esmeralda); color: var(--ink); }
  .prose :global(blockquote p) { color: inherit; }
  .prose :global(hr) { margin: 36px 0; border: 0; border-top: 1px solid var(--line); }
  .prose :global(table) { display: block; width: 100%; overflow-x: auto; margin: 22px 0; border-collapse: collapse; font-size: 16px; }
  .prose :global(th) { text-align: left; font-family: var(--font-title); font-weight: 600; font-size: 14px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); padding: 10px 18px 10px 0; border-bottom: 2px solid var(--ink); white-space: nowrap; }
  .prose :global(td) { padding: 12px 18px 12px 0; border-bottom: 1px solid var(--line); color: var(--grafito); line-height: 1.55; vertical-align: top; }
  .post-cta { margin-top: 56px; padding: 30px 32px; border: 1px solid var(--line); border-top: 3px solid var(--esmeralda); background: #fff; }
  .post-cta-t { font-family: var(--font-title); font-weight: 600; font-size: 21px; letter-spacing: -0.01em; color: var(--ink); }
  .post-cta p:not(.post-cta-t) { margin-top: 8px; font-size: 16px; line-height: 1.6; color: var(--grafito); }
  .post-cta-acciones { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 20px; }
  .seguir { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); }
  .seguir ul { margin-top: 12px; list-style: none; padding: 0; }
  .seguir li { margin: 10px 0; }
  .seguir a { font-family: var(--font-title); font-weight: 600; font-size: 18px; letter-spacing: -0.01em; color: var(--ink); }
  .seguir a:hover { color: var(--esmeralda-text); }
</style>
