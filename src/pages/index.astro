---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Cinta from '../components/Cinta.astro';
import Servicios from '../components/Servicios.astro';
import Casos from '../components/Casos.astro';
import Paquetes from '../components/Paquetes.astro';
import Como from '../components/Como.astro';
import Nosotros from '../components/Nosotros.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WaFlotante from '../components/WaFlotante.astro';
---

<Base>
  <Header slot="header" />
  <Hero />
  <Cinta />
  <Servicios />
  <Casos />
  <Paquetes />
  <Como />
  <Nosotros />
  <Faq />
  <Contacto />
  <WaFlotante />
  <Footer slot="footer" />
</Base>
