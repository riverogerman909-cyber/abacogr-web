---
const casos = [
  { nombre: 'Algosphere', url: 'https://algosphere.uy', dominio: 'algosphere.uy', tags: ['Cliente', 'Web', 'Identidad'],
    texto: 'Inversión algorítmica. Web con esfera de partículas 3D y gráfico animado. Entregada en agosto de 2026.', img: 'algosphere' },
  { nombre: 'Delta Academia', url: 'https://deltaacademiagr.com', dominio: 'deltaacademiagr.com', tags: ['Proyecto propio', 'Web', 'Identidad'],
    texto: 'Academia de clases para estudiantes de la Facultad de Ciencias Económicas. Proyecto propio del estudio: web, marca y contenido.', img: 'delta' },
];
---
<section id="casos" class="casos">
  <div class="wrap folio">
    <p class="eyebrow folio-label reveal">02 — Casos</p>
    <div class="folio-body">
      <div class="section-head reveal">
        <h2>Sitios reales, entregados<span class="dot">.</span></h2>
        <p class="lead">No mostramos maquetas. Entrá, navegá y juzgá vos.</p>
      </div>
      <div class="casos-lista">
        {casos.map((c, i) => (
          <article class={`caso reveal${i % 2 ? ' caso--inv' : ''}`}>
            <div class="mock" data-tilt>
              <div class="browser">
                <div class="browser-bar"><span></span><span></span><span></span><em>{c.dominio}</em></div>
                <img src={`/casos/${c.img}-desktop.webp`} alt={`Captura de la web de ${c.nombre}`} width="1200" height="750" loading="lazy" decoding="async" />
              </div>
              <div class="phone">
                <img src={`/casos/${c.img}-mobile.webp`} alt="" width="600" height="1298" loading="lazy" decoding="async" />
              </div>
            </div>
            <div class="caso-texto">
              <p class="caso-tags">{c.tags.map((t) => <span>{t}</span>)}</p>
              <h3>{c.nombre}</h3>
              <p>{c.texto}</p>
              <a href={c.url} target="_blank" rel="noopener" class="caso-link">Ver sitio <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .casos { background: var(--blanco); }
  .casos-lista { display: flex; flex-direction: column; gap: clamp(48px, 7vw, 96px); }
  .caso { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 900px) {
    .caso { grid-template-columns: 7fr 5fr; gap: 56px; }
    .caso--inv { grid-template-columns: 5fr 7fr; }
    .caso--inv .mock { order: 2; }
  }
  .mock { position: relative; perspective: 1200px; transform-style: preserve-3d; padding-bottom: 13%; }
  .browser { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: #fff; box-shadow: var(--shadow-card);
    transform: rotateX(calc(2deg + var(--rx, 0) * 6deg)) rotateY(calc(-6deg + var(--ry, 0) * -6deg)); transition: transform 500ms var(--ease-out); }
  .mock.is-tilting .browser, .mock.is-tilting .phone { transition: transform 120ms linear; }
  .browser-bar { display: flex; align-items: center; gap: 6px; height: 36px; padding: 0 12px; border-bottom: 1px solid var(--line); background: var(--hueso); }
  .browser-bar span { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
  .browser-bar em { margin-left: 10px; font-style: normal; font-size: 12px; color: var(--grafito-80); }
  .browser img { width: 100%; height: auto; aspect-ratio: 1200 / 750; object-fit: cover; object-position: top; }
  .phone { position: absolute; right: 2%; bottom: 0; width: 26%; max-width: 200px; border-radius: 36px; border: 1px solid var(--ink); overflow: hidden; background: #fff; box-shadow: var(--shadow-card);
    transform: translateZ(40px) rotateX(calc(2deg + var(--rx, 0) * 6deg)) rotateY(calc(-6deg + var(--ry, 0) * -6deg)); transition: transform 500ms var(--ease-out); }
  .phone img { width: 100%; height: auto; aspect-ratio: 600 / 1298; object-fit: cover; object-position: top; }
  .caso-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .caso-tags span { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--esmeralda-text); background: var(--esmeralda-100); padding: 5px 10px; border-radius: var(--pill); }
  .caso h3 { font-size: clamp(26px, 3vw, 36px); margin-bottom: 12px; }
  .caso-texto p { max-width: 40ch; }
  .caso-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 18px; font-weight: 600; color: var(--ink); border-bottom: 2px solid var(--esmeralda); padding-bottom: 2px; min-height: 44px; }
  .caso-link:hover { color: var(--esmeralda-text); }
  @media (prefers-reduced-motion: reduce) { .browser, .phone { transform: none !important; } .phone { transform: translateZ(0) !important; } }
</style>
