---
const items = [
  { n: '01', t: 'Página web que convierte', d: 'Rápida, clara y pensada para que te contacten. Con tu dominio propio.', ico: 'web' },
  { n: '02', t: 'WhatsApp Business', d: 'Catálogo, respuestas automáticas y botón directo. Tu canal de ventas ordenado.', ico: 'chat' },
  { n: '03', t: 'Instagram con contenido', d: 'Perfil prolijo y piezas listas para publicar. Arrancás con material, no en blanco.', ico: 'ig' },
  { n: '04', t: 'Listo en días', d: 'Un proyecto con principio y fin. Sin cuotas eternas ni depender de nadie.', ico: 'cal' },
];
---
<section id="servicios" class="servicios">
  <div class="wrap folio">
    <p class="eyebrow folio-label reveal">01 — Servicios</p>
    <div class="folio-body">
      <div class="section-head reveal">
        <h2>Tu presencia online, servicio por servicio<span class="dot">.</span></h2>
        <p class="lead">Podés arrancar por uno o llevarte todo junto en un paquete.</p>
      </div>
      <div class="filas">
        {items.map((it, i) => (
          <div class="fila reveal" style={`--i:${i}`}>
            <span class="hairline" style={`--i:${i}`}></span>
            <span class="fila-n">{it.n}</span>
            <h3>{it.t}</h3>
            <p>{it.d}</p>
            <span class="fila-ico" aria-hidden="true">
              {it.ico === 'web' && <svg viewBox="0 0 28 28"><rect x="2" y="5" width="24" height="18" rx="3"/><path d="M2 10h24"/><circle cx="6" cy="7.5" r=".9" fill="currentColor" stroke="none"/><circle cx="9" cy="7.5" r=".9" fill="currentColor" stroke="none"/><circle cx="12" cy="7.5" r=".9" fill="currentColor" stroke="none"/></svg>}
              {it.ico === 'chat' && <svg viewBox="0 0 28 28"><path d="M14 4a10 10 0 0 0-8.7 15l-1.3 5 5.1-1.3A10 10 0 1 0 14 4z"/><path d="M9.5 14h9M9.5 10.5h6"/></svg>}
              {it.ico === 'ig' && <svg viewBox="0 0 28 28"><rect x="4" y="4" width="20" height="20" rx="6"/><circle cx="14" cy="14" r="4.5"/><circle cx="20" cy="8" r="1" fill="currentColor" stroke="none"/></svg>}
              {it.ico === 'cal' && <svg viewBox="0 0 28 28"><rect x="3" y="6" width="22" height="19" rx="3"/><path d="M3 11h22M9 3v5M19 3v5M9.5 18l3 3 6-6"/></svg>}
            </span>
          </div>
        ))}
        <span class="hairline hairline-end" style="--i:4"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .filas { display: flex; flex-direction: column; }
  .fila { position: relative; display: grid; grid-template-columns: 40px 1fr; column-gap: 16px; padding: 28px 0; }
  .fila .hairline { position: absolute; top: 0; left: 0; right: 0; }
  .hairline-end { display: block; }
  .fila-n { font-family: var(--font-title); font-weight: 300; font-size: 22px; color: var(--niebla); transition: color 600ms var(--ease-out); transition-delay: calc(var(--i, 0) * 80ms + 300ms); }
  .fila.in .fila-n { color: var(--esmeralda-dark); }
  .fila h3 { font-size: clamp(24px, 2.6vw, 34px); letter-spacing: -.025em; }
  .fila p { grid-column: 2; margin-top: 8px; max-width: 46ch; }
  .fila-ico { display: none; color: var(--ink); transition: transform var(--t-fast) var(--ease-out); }
  .fila-ico svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  @media (min-width: 900px) {
    .fila { grid-template-columns: 64px 5fr 6fr 56px; column-gap: 24px; align-items: start; padding: 34px 0; }
    .fila p { grid-column: 3; margin-top: 6px; }
    .fila-ico { display: block; justify-self: end; margin-top: 8px; }
    .fila:hover .fila-ico { transform: translateX(4px); }
  }
</style>
