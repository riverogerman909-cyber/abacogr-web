---
const wa = 'https://wa.me/59898521288?text=Hola%20%C3%81baco%2C%20quiero%20mejorar%20la%20presencia%20digital%20de%20mi%20negocio.';
---
<section id="inicio" class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-texto">
        <p class="eyebrow">Presencia digital para profesionales y negocios · Uruguay</p>
        <h1>Tu negocio,<br />ordenado<br />y online<span class="dot">.</span></h1>
        <p class="lead">
          Armamos tu web, tu WhatsApp Business y tus redes en un proyecto claro,
          con precio cerrado. Empieza y termina: te dejamos todo funcionando y sabiendo usarlo.
        </p>
        <div class="hero-cta">
          <a href="#paquetes" class="btn btn-ink">Ver paquetes y precios</a>
          <a href={wa} class="btn btn-wa" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 1.8a8.2 8.2 0 1 1-4.2 15.3l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 0 1 12 3.8zm-3.2 4.3c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3 2.4 1 2.9.8 3.4.7.5 0 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3l-2-1c-.3-.1-.5-.2-.7.2l-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.5-.9-.8-1.5-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5.3-.5v-.5l-.9-2.2c-.2-.5-.5-.5-.7-.5h-.6z"/></svg>
            Escribinos por WhatsApp
          </a>
        </div>
        <p class="hero-trust">Marketing hecho por quien entiende de números y de negocios. Claro, medido y sin vueltas.</p>
      </div>

      <div class="hero-obj" data-abaco>
        <div class="hero-obj-shadow" aria-hidden="true"></div>
        <svg class="hero-obj-svg" viewBox="18 18 64 64" role="img" aria-label="Sello de Ábaco: un ábaco de tres varillas y nueve bolitas">
          <rect x="18" y="20" width="64" height="60" rx="13" fill="none" stroke="#14243F" stroke-width="4"/>
          <line x1="28" y1="38" x2="72" y2="38" stroke="#AAB4C2" stroke-width="2.5"/>
          <line x1="28" y1="50" x2="72" y2="50" stroke="#AAB4C2" stroke-width="2.5"/>
          <line x1="28" y1="62" x2="72" y2="62" stroke="#AAB4C2" stroke-width="2.5"/>
          <circle cx="37" cy="38" r="5.4" fill="#12A187"/><circle cx="51" cy="38" r="5.4" fill="#14243F"/><circle cx="65" cy="38" r="5.4" fill="#14243F"/>
          <circle cx="33" cy="50" r="5.4" fill="#14243F"/><circle cx="58" cy="50" r="5.4" fill="#12A187"/><circle cx="68" cy="50" r="5.4" fill="#14243F"/>
          <circle cx="35" cy="62" r="5.4" fill="#14243F"/><circle cx="49" cy="62" r="5.4" fill="#12A187"/><circle cx="65" cy="62" r="5.4" fill="#EF6D45"/>
        </svg>
        <canvas class="hero-obj-canvas" aria-hidden="true" tabindex="-1"></canvas>
        <p class="hero-obj-caption" hidden>Arrastrá las bolitas</p>
      </div>
    </div>

    <ul class="hechos reveal">
      <li>Precios públicos</li>
      <li><span class="bolita" aria-hidden="true"></span>Proyecto con principio y fin</li>
      <li><span class="bolita" aria-hidden="true"></span>Todo queda a tu nombre</li>
    </ul>
  </div>
</section>

<style>
  .hero { border-top: 0; padding: clamp(40px, 6vw, 96px) 0 clamp(32px, 4vw, 56px); }
  .hero-grid { display: grid; gap: 32px; align-items: center; }
  .hero h1 { font-size: clamp(44px, 5.4vw, 72px); line-height: 1; letter-spacing: -.035em; margin: 18px 0 24px; }
  .hero .lead { max-width: 38ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin: 30px 0 22px; }
  .hero-trust { font-size: 15px; color: var(--grafito-80); max-width: 46ch; }

  /* objeto */
  .hero-obj { position: relative; width: 100%; height: 300px; --tilt: 0; --tilt-abs: 0; --p: 0; }
  .hero-obj-shadow { position: absolute; left: 50%; bottom: 6%; width: 60%; height: 14%; transform: translateX(-50%) translateX(calc(var(--tilt) * -6%)) scaleX(calc(1 - var(--tilt-abs) * .15)) scale(calc(1 - var(--p) * .3)); background: radial-gradient(ellipse at center, rgba(20, 36, 63, .18), transparent 70%); transition: transform 200ms linear; }
  .hero-obj-svg { position: absolute; inset: 12%; width: 76%; height: 76%; transform: perspective(1200px) rotateY(-12deg) rotateX(8deg); transform-style: preserve-3d; transition: opacity 400ms ease; }
  .hero-obj[data-tilt] .hero-obj-svg { transform: perspective(1200px) rotateY(calc(-12deg + var(--ry, 0) * 4deg)) rotateX(calc(8deg + var(--rx, 0) * -4deg)); transition: transform 500ms var(--ease-out), opacity 400ms ease; }
  .hero-obj-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 400ms ease; touch-action: pan-y; }
  .hero-obj.is-3d .hero-obj-canvas { opacity: 1; }
  .hero-obj.is-3d .hero-obj-svg { opacity: 0; }
  .hero-obj-caption { position: absolute; left: 0; right: 0; bottom: -4px; text-align: center; font-size: 12px; color: var(--grafito-80); }

  .hechos { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-top: clamp(28px, 4vw, 48px); padding-top: 20px; border-top: 1px solid var(--line); font-size: 14px; font-weight: 500; color: var(--grafito); }
  .hechos li { display: flex; align-items: center; gap: 10px; }
  .hechos .bolita { width: 7px; height: 7px; }

  @media (min-width: 900px) {
    .hechos { flex-direction: row; gap: 12px; }
    .hechos .bolita { margin-right: 2px; }
  }
  @media (min-width: 1024px) {
    .hero { padding: clamp(56px, 8vw, 110px) 0 clamp(40px, 5vw, 64px); }
    .hero-grid { grid-template-columns: 7fr 5fr; gap: 48px; }
    .hero-obj { aspect-ratio: 1; height: auto; max-width: 560px; justify-self: center; }
  }
  @media (max-width: 420px) { .hero .eyebrow { letter-spacing: .1em; font-size: 12px; } }
  @media (prefers-reduced-motion: reduce) { .hero-obj-svg, .hero-obj-shadow { transition: none; } }
</style>
