---
const wa = 'https://wa.me/59898521288?text=Hola%20%C3%81baco%2C%20quiero%20mejorar%20la%20presencia%20digital%20de%20mi%20negocio.';
const nav = [['/#servicios', 'Servicios'], ['/#casos', 'Casos'], ['/#paquetes', 'Paquetes'], ['/#como', 'Cómo trabajamos'], ['/blog/', 'Blog']];
const onBlog = Astro.url.pathname.startsWith('/blog');
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="#inicio" class="brand" aria-label="Ábaco, inicio">
      <svg width="34" height="34" viewBox="0 0 58 58" aria-hidden="true">
        <rect x="4" y="6" width="50" height="46" rx="9" fill="none" stroke="#14243F" stroke-width="2.5" />
        <line x1="10" y1="18" x2="48" y2="18" stroke="#AAB4C2" stroke-width="1.5" />
        <line x1="10" y1="29" x2="48" y2="29" stroke="#AAB4C2" stroke-width="1.5" />
        <line x1="10" y1="40" x2="48" y2="40" stroke="#AAB4C2" stroke-width="1.5" />
        <circle cx="16" cy="18" r="3.6" fill="#12A187" /><circle cx="24" cy="18" r="3.6" fill="#14243F" /><circle cx="43" cy="18" r="3.6" fill="#14243F" />
        <circle cx="14" cy="29" r="3.6" fill="#14243F" /><circle cx="38" cy="29" r="3.6" fill="#12A187" /><circle cx="46" cy="29" r="3.6" fill="#14243F" />
        <circle cx="17" cy="40" r="3.6" fill="#14243F" /><circle cx="25" cy="40" r="3.6" fill="#12A187" /><circle cx="42" cy="40" r="3.6" fill="#EF6D45" />
      </svg>
      <span class="brand-word">ábaco</span>
    </a>
    <nav class="nav-links" aria-label="Secciones">
      {nav.map(([href, t]) => <a href={href} class:list={[{ 'is-active': href === '/blog/' && onBlog }]}>{t}</a>)}
    </nav>
    <a href={wa} class="btn btn-ink header-cta" target="_blank" rel="noopener">Escribinos</a>
    <button class="menu-btn" type="button" data-menu-open aria-haspopup="dialog">Menú</button>
  </div>
</header>

<dialog class="menu" aria-label="Menú">
  <div class="menu-inner">
    <div class="menu-top">
      <span class="brand-word">ábaco</span>
      <button type="button" class="menu-close" data-menu-close>Cerrar</button>
    </div>
    <nav class="menu-nav" aria-label="Secciones">
      {[...nav, ['/#contacto', 'Contacto']].map(([href, t]) => <a href={href}>{t}</a>)}
    </nav>
    <a href={wa} class="btn btn-wa menu-wa" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 1.8a8.2 8.2 0 1 1-4.2 15.3l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 0 1 12 3.8zm-3.2 4.3c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3 2.4 1 2.9.8 3.4.7.5 0 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3l-2-1c-.3-.1-.5-.2-.7.2l-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.5-.9-.8-1.5-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5.3-.5v-.5l-.9-2.2c-.2-.5-.5-.5-.7-.5h-.6z"/></svg>
      Escribinos por WhatsApp
    </a>
  </div>
</dialog>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: rgba(245, 246, 244, .92); backdrop-filter: saturate(160%) blur(10px); -webkit-backdrop-filter: saturate(160%) blur(10px); border-bottom: 1px solid transparent; transition: border-color var(--t-fast) ease; }
  .site-header.is-compact { border-bottom-color: var(--line); }
  .header-inner { display: flex; align-items: center; gap: 24px; height: 64px; }
  .brand { display: flex; align-items: center; gap: 9px; }
  .brand-word { font-family: var(--font-title); font-weight: 600; font-size: 22px; color: var(--ink); letter-spacing: -.02em; }
  .nav-links { display: flex; gap: 28px; margin-left: auto; }
  .nav-links a { position: relative; font-size: 15px; font-weight: 500; color: var(--grafito); padding: 6px 0; }
  .nav-links a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--esmeralda); transform: scaleX(0); transform-origin: left; transition: transform var(--t-fast) var(--ease-out); }
  .nav-links a:hover::after, .nav-links a.is-active::after { transform: scaleX(1); }
  .header-cta { min-height: 44px; padding: 10px 20px; font-size: 14px; }
  .menu-btn { display: none; min-width: 48px; min-height: 48px; font-weight: 600; font-size: 15px; color: var(--ink); }

  .menu { border: 0; padding: 0; width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; background: var(--hueso); color: var(--grafito); }
  .menu::backdrop { background: rgba(20, 36, 63, .3); }
  .menu[open] { animation: menu-in 350ms var(--ease-out); }
  @keyframes menu-in { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
  .menu-inner { display: flex; flex-direction: column; min-height: 100dvh; padding: 16px var(--gutter) calc(24px + env(safe-area-inset-bottom)); }
  .menu-top { display: flex; align-items: center; justify-content: space-between; height: 50px; }
  .menu-close { min-width: 48px; min-height: 48px; font-weight: 600; font-size: 15px; color: var(--ink); }
  .menu-nav { display: flex; flex-direction: column; margin-top: 28px; flex: 1; }
  .menu-nav a { font-family: var(--font-title); font-weight: 600; font-size: 32px; color: var(--ink); letter-spacing: -.02em; padding: 12px 0; min-height: 56px; border-top: 1px solid var(--line); }
  .menu-wa { width: 100%; }

  @media (max-width: 899px) {
    .nav-links { display: none; }
    .header-inner { gap: 12px; }
    .header-cta { margin-left: auto; padding: 10px 16px; }
    .menu-btn { display: inline-flex; align-items: center; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .menu[open] { animation: none; } }
</style>
